# Copy to .env and fill in as needed. .env is git-ignored; never commit real keys.

# Investigation assistant (optional). Without credentials it uses a deterministic template.
ANTHROPIC_API_KEY=
INVESTIGATION_LLM=on            # set to "off" to always use the template
INVESTIGATION_MODEL=claude-opus-5-5

# Optional path overrides
PAYSIM_PATH=                    # defaults to data/raw/PS_20174392719_1491204439457_log.csv
FRAUD_DB_PATH=                  # defaults to data/processed/paysim.db
FRAUD_MODEL_PATH=               # defaults to models/fraud_model.joblib
SAFETY_MODEL_PATH=              # defaults to models/safety_model.joblib
LOG_LEVEL=INFO
